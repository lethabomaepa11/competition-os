+            <Text style={{ color: "#475569", fontSize: 15, lineHeight: 1.6 }}>{competition.description}</Text>
+          </Card>
+        )}
+
+        {/* Auth / Events section ΓÇö same as before */}
+        <Card style={{ borderRadius: 16, boxShadow: "0 4px 20px rgba(0,0,0,0.04)", marginBottom: 24 }}>
